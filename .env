DJANGO_ENV=development
DJANGO_SECRET_KEY=dev-secret-key-zamzam-foods-local-engineering-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── JWT Token Lifetimes ──────────────────────────────────────────────────────
# Access token: short-lived (browser fetches data). 15 min is the industry default.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# Refresh token: maximum possible lifetime of the JWT (hard ceiling).
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# JWT Signing Key
# IMPORTANT: Replace with a strong random value in production.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
# NEVER commit a real production secret to Git.
JWT_SECRET_KEY=dev-jwt-secret-zamzam-foods-token-key-2026-REPLACE-IN-PROD

# ─── Persistent Login (Driver / Manager only) ─────────────────────────────────
# How many days a Driver/Manager device stays logged in without re-entering
# their password. Set to 1, 2, or 3. Default: 3.
# This is independent of the JWT token lifetimes above.
PERSISTENT_LOGIN_DAYS=3

# ─── Cookie Security ──────────────────────────────────────────────────────────
# Development: False (allows HTTP on localhost)
# Production:  True  (requires HTTPS — never set False in production)
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax

