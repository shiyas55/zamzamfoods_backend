# ─── Zamzam Foods Backend — Environment Variables Template ───────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git. This .env.example file is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Django Core ──────────────────────────────────────────────────────────────
DJANGO_ENV=production
# Generate: python3 -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=

# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Get from: Supabase Dashboard → Settings → Database → Connection String
DATABASE_URL=

# ─── CORS & CSRF ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your Vercel frontend URL)
# Example: https://zamzam-foods.vercel.app
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30
PERSISTENT_LOGIN_DAYS=3

# ─── Cookie Security ─────────────────────────────────────────────────────────
# True in production (requires HTTPS). False only for local development.
JWT_COOKIE_SECURE=True
# Use "None" for cross-origin Vercel→Koyeb, "Lax" for same-origin
JWT_COOKIE_SAMESITE=None

# ─── SSL / HTTPS ─────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ─── Meta WhatsApp Cloud API (WhatsApp Business Platform) ─────────────────────



WHATSAPP_ACCESS_
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_